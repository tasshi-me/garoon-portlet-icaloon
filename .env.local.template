# 実 Garoon に接続するための設定テンプレート。
# コピーして使う（.env.local は gitignore 済み。コミット禁止）:
#   cp .env.local.template .env.local
#
# mock モード（ダミーの garoon）で使うだけなら .env.local は不要。

# 開発時の API モード: "proxy" = Vite dev サーバー経由で実 Garoon に接続
VITE_API_MODE=proxy

# 接続先 Garoon のベース URL
GAROON_BASE_URL=https://example.cybozu.com

# Garoon のログイン名とパスワード
GAROON_USERNAME=
GAROON_PASSWORD=

# セキュアアクセス（<subdomain>.s.cybozu.com）を使う場合のみ: クライアント証明書（.pfx）のパスとパスワード
GAROON_PFX_PATH=
GAROON_PFX_PASSPHRASE=
