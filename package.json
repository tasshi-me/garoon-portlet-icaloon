{
  "name": "garoon-portlet-icaloon",
  "version": "0.0.0",
  "description": "An iCalendar (.ics) importer for Garoon",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "tasshi (Masaharu Tashiro)",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_API_MODE=mock vite",
    "dev:proxy": "VITE_API_MODE=proxy vite",
    "build:bundle": "vite build",
    "build:xml": "tsx scripts/build-xml.ts",
    "build": "pnpm build:bundle && pnpm build:xml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts",
    "format": "biome format --write src scripts"
  },
  "dependencies": {
    "ical.js": "^2.1.0",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
