{
  "name": "icaroon",
  "version": "0.0.0",
  "description": "Garoon ポートレットとして動く ics インポートツール",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "tasshi (Masaharu Tashiro)",
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "dev": "vite",
    "build:bundle": "vite build",
    "build:xml": "tsx scripts/build-xml.ts",
    "build": "pnpm build:bundle && pnpm build:xml",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts",
    "format": "biome format --write src scripts"
  },
  "dependencies": {
    "ical.js": "^2.1.0",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^25.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
